+        }
+        if (StringUtils.findInArray("-part", args) != -1)
+            GenerateDesign.setPart(args[StringUtils.findInArray("-part", args) + 1]);
+        if (!Start.start())
+            return;
+        double util = 0.8;
+        int maxItems = 10;
+        if (StringUtils.findInArray("-util", args) != -1)
+            util = Double.parseDouble(args[StringUtils.findInArray("-util", args) + 1]);
+        if (StringUtils.findInArray("-maxItems", args) != -1)
+            maxItems = Integer.parseInt(args[StringUtils.findInArray("-maxItems", args) + 1]);
+        //-batches: target number of batches (runs in parallel); the items are spread over them
+        int nBatches = 0;
+        if (StringUtils.findInArray("-batches", args) != -1)
+            nBatches = Integer.parseInt(args[StringUtils.findInArray("-batches", args) + 1]);
+        List<String> names = Files.readAllLines(Paths.get(args[StringUtils.findInArray("-f", args) + 1]));
+
+        int maxRows = ResourceElement.endi - ResourceElement.starti + 1;
+        int cols = MapElement.map.get(0).size();
+        int variants = System.getenv("DYNARAPID_VARIANTS") == null ? 2 : Integer.parseInt(System.getenv("DYNARAPID_VARIANTS"));
+
+        //shapes (and variants at disjoint columns for components with BRAMs / DSPs)
+        List<Item> items = new ArrayList<>();
+        Map<String, Component> comps = new LinkedHashMap<>();
+        for (String name : names)
+        {
+            name = name.trim();
+            if (name.isEmpty())
+                continue;
+            Component comp = new Component(name, false);
+            comps.put(name, comp);
+            int nv = (comp.dcp.bram > 0 || comp.dcp.dsp > 0) ? variants : 1;
+            boolean used[] = new boolean[cols];
+            for (int v = 0; v < nv; v++)
+            {
+                int shape[] = GenerateShapedPblocks.chooseShape(comp, util, 1.0, maxRows, v == 0 ? null : used.clone());
+                if (shape == null)
+                    break;
+                Item it = new Item();
+                it.comp = comp;
+                it.j = shape[0];
+                it.r = shape[1];
+                it.c = shape[2];
+                items.add(it);
+                for (int j = shape[0]; j < shape[0] + shape[2] && j < cols; j++)
+                    used[j] = true;
+            }
+        }
+
+        //items that fail in a batch are retried right away (by the batch's thread) at lower
+        //utilization, while the other batches are still running
+        MAX_ROWS = maxRows;
+        ALL.addAll(items);
+        runRound(items, util, maxItems, nBatches, cols, 1);
+
+        for (String name : comps.keySet())
+        {
+            boolean any = false;
+            for (Item it : new ArrayList<>(ALL))
+                if (it.comp.dcpName.equals(name) && it.ok)
+                {
+                    any = true;
+                    System.out.println("BATCH_OK " + name + " " + it.pblock.pblockName);
+                }
+            if (!any)
+                System.out.println("BATCH_FAILED " + name);
+        }
+        System.exit(0);
+    }
+
+    //new items (at the given utilization) for the failed items of a batch
+    static List<Item> retryItems(List<Item> batch, double u2)
+    {
+        List<Item> retry = new ArrayList<>();
+        for (Item it : batch)
+        {
+            if (it.ok)
+                continue;
+            int shape[] = GenerateShapedPblocks.chooseShape(it.comp, u2, 1.0, MAX_ROWS, null);
+            if (shape == null)
+                continue;
+            Item n = new Item();
+            n.comp = it.comp;
+            n.r = shape[1];
+            n.c = shape[2];
+            //keep the columns of the failed item (its variant role) if the shape fits there
+            n.j = GenerateShapedPblocks.fits(it.comp, u2, ResourceElement.starti, it.j, n.r, n.c) ? it.j : shape[0];
+            retry.add(n);
+        }
+        return retry;
+    }
+
+    //packs the items into batches and runs them (items get pblock and ok status)
+    static void runRound(List<Item> roundItems, double util, int maxItems, int nBatches, int cols, int round) throws Exception
+    {
+        //pack the pblocks into batches: every item keeps its columns (they determine where it
+        //can be relocated to) and gets the topmost free rows of a batch it fits into. Largest
+        //items first, each into the batch with the least area so far (balanced run times).
+        List<Item> items = new ArrayList<>(roundItems);
+        items.sort((a, b) -> Integer.compare(b.r * b.c, a.r * a.c));
+        if (nBatches > 0)
+            maxItems = Math.max(maxItems, (items.size() + nBatches - 1) / nBatches);
+        List<List<Item>> batches = new ArrayList<>();
+        List<boolean[][]> occupancy = new ArrayList<>();
+        List<Integer> area = new ArrayList<>();
+        int rows = MapElement.map.size();
+        for (int b = 0; b < nBatches; b++)
+        {
+            batches.add(new ArrayList<>());
+            occupancy.add(new boolean[rows][cols]);
+            area.add(0);
+        }
+        for (Item it : items)
+        {
+            List<Integer> order = new ArrayList<>();
+            for (int b = 0; b < batches.size(); b++)
+                order.add(b);
+            order.sort((a, b) -> Integer.compare(area.get(a), area.get(b)));
+            order.add(-1); //a new batch
+            for (int b : order)
+            {
+                if (it.i >= 0)
+                    break;
+                if (b == -1)
+                {
+                    batches.add(new ArrayList<>());
+                    occupancy.add(new boolean[rows][cols]);
+                    area.add(0);
+                    b = batches.size() - 1;
+                }
+                if (batches.get(b).size() >= maxItems)
+                    continue;
+                boolean occ[][] = occupancy.get(b);
+                int inc = Math.max(1, it.comp.incFactor);
+                for (int i = ResourceElement.starti; i + it.r - 1 <= ResourceElement.endi && it.i < 0; i += inc)
+                {
+                    boolean free = true;
+                    for (int a = i; a < i + it.r && free; a++)
+                        for (int c = it.j; c < it.j + it.c && free; c++)
+                            free = !occ[a][c];
+                    if (!free || !GenerateShapedPblocks.fits(it.comp, util, i, it.j, it.r, it.c))
+                        continue;
+                    it.i = i;
+                    for (int a = i; a < i + it.r; a++)
+                        for (int c = it.j; c < it.j + it.c; c++)
+                            occ[a][c] = true;
+                    batches.get(b).add(it);
+                    area.set(b, area.get(b) + it.r * it.c);
+                }
+            }
+        }
+        for (Item it : items)
+            if (it.i >= 0)
+                it.pblock = new Pblock(it.comp, it.i, it.j, it.r, it.c, 2, false, false);
+        System.out.println("Round " + round + ": packed " + items.size() + " pblocks into " + batches.size() + " batches");
+
+        File root = new File(LocationParser.exposedDCPs + "batches_" + ProcessHandle.current().pid() + "_r" + round);
+        root.mkdirs();
+        List<Thread> threads = new ArrayList<>();
+        final int maxItemsF = maxItems;
+        for (int b = 0; b < batches.size(); b++)
+        {
+            final int bb = b;
+            final List<Item> batch = batches.get(b);
+            if (batch.isEmpty())
+                continue;
+            Thread th = new Thread(() -> {
+                try
+                {
+                    runBatch(new File(root, "b" + bb), batch);
+                    if (round == 1)
+                    {
+                        List<Item> retry = retryItems(batch, util * 0.75);
+                        if (!retry.isEmpty())
+                        {
+                            System.out.println("Retrying " + retry.size() + " pblocks of batch " + bb + " at utilization " + (util * 0.75));
+                            ALL.addAll(retry);
+                            runRound(retry, util * 0.75, maxItemsF, 1, cols, 100 + bb);
+                        }
+                    }
+                }
+                catch (Exception e) { e.printStackTrace(); }
+            });
+            th.start();
+            threads.add(th);
+        }
+        for (Thread th : threads)
+            th.join();
+
+    }
+
+    static String bus(EDIFPort p)
+    {
+        if (!p.isBus())
+            return "";
+        return "[" + p.getLeft() + ":" + p.getRight() + "] ";
+    }
+
+    static void runBatch(File dir, List<Item> batch) throws Exception
+    {
+        dir.mkdirs();
+        //ports of the components from their synthesized netlists
+        Map<String, EDIFCell> tops = new LinkedHashMap<>();
+        for (Item it : batch)
+            if (!tops.containsKey(it.comp.dcpName))
+            {
+                EDIFNetlist n;
+                synchronized (RW_LOCK)
+                {
+                    n = EDIFTools.readEdifFile(it.comp.moduleLoc.replace(".dcp", ".edf"));
+                }
+                tops.put(it.comp.dcpName, n.getTopCell());
+            }
+        StringBuilder v = new StringBuilder();
+        for (Map.Entry<String, EDIFCell> e : tops.entrySet())
+        {
+            List<String> ports = new ArrayList<>();
+            for (EDIFPort p : e.getValue().getPorts())
+                ports.add("    " + (p.isInput() ? "input " : "output ") + bus(p) + p.getBusName());
+            v.append("(* black_box *) module " + e.getKey() + " (\n" + String.join(",\n", ports) + "\n);\nendmodule\n");
+        }
+        List<String> topPorts = new ArrayList<>();
+        topPorts.add("    input clk");
+        StringBuilder insts = new StringBuilder();
+        for (int k = 0; k < batch.size(); k++)
+        {
+            Item it = batch.get(k);
+            it.k = k;
+            List<String> conns = new ArrayList<>();
+            for (EDIFPort p : tops.get(it.comp.dcpName).getPorts())
+            {
+                String pn = p.getBusName();
+                if (pn.equals("clk"))
+                {
+                    conns.add(".clk(clk)");
+                    continue;
+                }
+                topPorts.add("    " + (p.isInput() ? "input " : "output ") + bus(p) + "c" + k + "_" + pn);
+                conns.add("." + pn + "(c" + k + "_" + pn + ")");
+            }
+            insts.append("    " + it.comp.dcpName + " c" + k + " (" + String.join(", ", conns) + ");\n");
+        }
+        v.append("module top (\n" + String.join(",\n", topPorts) + "\n);\n" + insts + "endmodule\n");
+        Path topV = dir.toPath().resolve("top.v");
+        Files.write(topV, v.toString().getBytes(StandardCharsets.UTF_8));
+
+        //one place and route of all components
+        StringBuilder t = new StringBuilder();
+        t.append("set_param general.maxThreads " + VivadoRun.vivadoThreads() + "\n");
+        t.append("read_verilog " + topV + "\n");
+        for (Item it : batch)
+            if (t.indexOf(it.comp.moduleLoc) < 0)
+                t.append("read_checkpoint " + it.comp.moduleLoc + "\n");
+        //Vivado 2024.2 fails link_design of a Verilog top over checkpoints with the non-demotable
+        //[Designutils 20-50] "Could not find synplify library file" although the link completes;
+        //accept that, but require an open design without black boxes
+        t.append("if {[catch {link_design -top top -part " + GenerateDesign.fpga_part + " -mode out_of_context} err]} {\n");
+        t.append("    if {[catch {current_design}] || [llength [get_cells -quiet -hier -filter {IS_BLACKBOX}]] > 0} {error $err}\n");
+        t.append("    puts \"INFO: link_design error ignored, design linked: $err\"\n");
+        t.append("}\n");
+        t.append("create_clock -period " + VivadoRun.clockPeriod() + " -name clk [get_ports clk]\n");
+        t.append("set_property HD.CLK_SRC " + VivadoRun.clockSourceSite() + " [get_ports clk]\n");
+        for (Item it : batch)
+        {
+            String pb = "pb" + it.k;
+            t.append("set_property DONT_TOUCH true [get_cells c" + it.k + "]\n");
+            t.append("create_pblock " + pb + "\n");
+            t.append(StringUtils.getPblockString(it.pblock.getAllSites(), pb));
+            t.append("add_cells_to_pblock " + pb + " [get_cells c" + it.k + "]\n");
+            t.append("set_property CONTAIN_ROUTING 1 [get_pblocks " + pb + "]\n");
+        }
+        //Vivado 2024.2 makes route_design fail ([Route 35-2] "not legally routed") when overlaps
+        //remain; 2023.1 finished with routing errors. Continue either way: the errors are
+        //attributed to components below
+        t.append("opt_design\nplace_design\n");
+        t.append("if {[catch {route_design} err]} {puts \"INFO: route_design error: $err\"}\n");
+        //routing errors per component: nets with conflicts (overlaps) or antennas, by the cell
+        //prefix of their name (per-net route reports list every route tree and are very slow).
+        //Errors that cannot be attributed fail the whole batch.
+        t.append("set rs [report_route_status -return_string]\n"
+            + "set e -1\nregexp {nets with routing errors[.]* *: *(\\d+)} $rs -> e\n"
+            + "array set cnt {}\nset attributed 0\n"
+            + "foreach n [get_nets -quiet -hier -filter {ROUTE_STATUS == CONFLICTS || ROUTE_STATUS == ANTENNAS}] {\n"
+            + "  if {[regexp {^c(\\d+)/} $n -> k]} {incr cnt($k); incr attributed}\n"
+            + "}\n"
+            + "puts \"ROUTE_ERRORS $e attributed $attributed\"\n");
+        for (Item it : batch)
+            t.append("if {$e == 0} {puts \"RESULT c" + it.k + " 0\"} elseif {$attributed == 0 || $e < 0} {puts \"RESULT c" + it.k + " $e\"} "
+                + "elseif {[info exists cnt(" + it.k + ")]} {puts \"RESULT c" + it.k + " $cnt(" + it.k + ")\"} else {puts \"RESULT c" + it.k + " 0\"}\n");
+        String batchDcp = dir.toPath().resolve("batch.dcp").toString();
+        t.append("write_checkpoint -force " + batchDcp + "\n");
+        t.append("write_edif -force " + batchDcp.replace(".dcp", ".edf") + "\n");
+        Path tcl = dir.toPath().resolve("batch.tcl");
+        Path log = dir.toPath().resolve("batch.log");
+        Files.write(tcl, t.toString().getBytes(StandardCharsets.UTF_8));
+        //a congested batch can keep the router busy for a long time: its components are
+        //then retried / built individually (DYNARAPID_BATCH_TIMEOUT_S, default 300 s; batches of
+        //small components take 1-2.5 min, a congested one can route for many minutes)
+        String to = System.getenv("DYNARAPID_BATCH_TIMEOUT_S");
+        VivadoRun.setTimeLimitMinutes(Math.max(1, (int) Math.ceil((to == null ? 300 : Double.parseDouble(to)) / 60.0)));
+        VivadoRun.vivadoRun(tcl.toString(), log.toString(), false, "batch pblocks: " + dir, 0);
+        VivadoRun.setTimeLimitMinutes(60);
+
+        String out = new String(Files.readAllBytes(log), StandardCharsets.ISO_8859_1);
+        Map<Integer, Integer> errors = new HashMap<>();
+        Matcher m = Pattern.compile("^RESULT c(\\d+) (\\d+)", Pattern.MULTILINE).matcher(out);
+        while (m.find())
+            errors.put(Integer.parseInt(m.group(1)), Integer.parseInt(m.group(2)));
+        if (!new File(batchDcp).exists() || errors.isEmpty())
+        {
+            System.out.println("Batch " + dir + " failed (see " + log + ")");
+            return;
+        }
+
+        //split: each cell's implementation into the component's own design
+        List<Item> split = new ArrayList<>();
+        synchronized (RW_LOCK)
+        {
+            Design src = Design.readCheckpoint(batchDcp, batchDcp.replace(".dcp", ".edf"));
+            for (Item it : batch)
+            {
+                if (errors.getOrDefault(it.k, 1) != 0)
+                {
+                    System.out.println("Routing errors in " + it.pblock.pblockName + " (batch " + dir + ")");
+                    continue;
+                }
+                Path libDir = LocationParser.getPlacedRoutedDCPsPath().resolve(it.comp.dcpName);
+                libDir.toFile().mkdirs();
+                String dcp = libDir.resolve(it.pblock.pblockName + "_placedRouted.dcp").toString();
+                //a component that cannot be split (e.g. encrypted IP cells: copyImplementation
+                //fails on their site routing) must not take the rest of the batch with it
+                try
+                {
+                    Design dest = Design.readCheckpoint(it.comp.moduleLoc, it.comp.moduleLoc.replace(".dcp", ".edf"));
+                    Map<String, String> map = new HashMap<>();
+                    map.put("c" + it.k, "");
+                    DesignTools.copyImplementation(src, dest, true, true, false, false, map);
+                    //LUT route-through cells keep a reference to the batch hierarchy (c<k>/...)
+                    //in the written placement; Vivado then drops the whole site ("placement
+                    //information for 1 sites failed to restore") and its cells stay without a
+                    //LOC. This was seen for route-throughs on 5LUT BELs (into FFs / CARRY8), which
+                    //Vivado rebuilds from the site PIPs, so drop those. 6LUT route-throughs (CARRY8
+                    //S inputs) must stay: one entering on a pin other than A6 is not rebuilt and the
+                    //net ends up as an antenna in the assembly (DRC RTSTAT-5, CNV IODMA).
+                    for (SiteInst si : dest.getSiteInsts())
+                        for (Cell c : new ArrayList<>(si.getCells()))
+                            if (c.isRoutethru() && c.getBELName().endsWith("5LUT"))
+                                si.removeCell(c.getBEL());
+                    //the batch netlist keeps one library per linked checkpoint (work_c<k>, ...);
+                    //library entries must have all their cells in the work library
+                    dest.getNetlist().consolidateAllToWorkLibrary();
+                    dest.getNetlist().removeUnusedCellsFromAllWorkLibraries();
+                    dest.writeCheckpoint(dcp);
+                    EDIFTools.writeEDIFFile(dcp.replace(".dcp", ".edf"), dest.getNetlist(), GenerateDesign.fpga_part);
+                    split.add(it);
+                }
+                catch (Exception e)
+                {
+                    System.out.println("Split failed for " + it.pblock.pblockName + " (batch " + dir + "): " + e);
+                    e.printStackTrace(System.out);
+                    GenerateFastPblocks.removeOutputs(libDir, it.pblock.pblockName);
+                }
+            }
+        }
+        if (split.isEmpty())
+            return;
+
+        //pblock constraint, utilization and RapidWright metadata of each component
+        StringBuilder md = new StringBuilder();
+        md.append("set_param general.maxThreads " + VivadoRun.vivadoThreads() + "\n");
+        md.append(LocationParser.sourceRW + "\n");
+        for (Item it : split)
+        {
+            Path libDir = LocationParser.getPlacedRoutedDCPsPath().resolve(it.comp.dcpName);
+            String prefix = libDir.resolve(it.pblock.pblockName).toString();
+            md.append("open_checkpoint " + prefix + "_placedRouted.dcp\n");
+            //every cell must have survived the split (a site that fails to restore leaves its
+            //cells without a LOC and would be lost silently): otherwise no META_OK -> the
+            //component falls back to an individual build
+            md.append("set noloc 0\nforeach c [get_cells -hier -filter {IS_PRIMITIVE && REF_NAME!=GND && REF_NAME!=VCC}] "
+                + "{ if {[get_property LOC $c] eq \"\"} {incr noloc} }\n");
+            md.append("if {$noloc > 0} { puts \"SPLIT_UNPLACED " + it.pblock.pblockName + " $noloc\"; close_design; } else {\n");
+            md.append("create_clock -period " + VivadoRun.clockPeriod() + " -name clk [get_ports clk]\n");
+            md.append("create_pblock pblock_1\n");
+            md.append(StringUtils.getPblockString(it.pblock.getAllSites(), "pblock_1"));
+            md.append("add_cells_to_pblock pblock_1 -top\n");
+            md.append("set_property CONTAIN_ROUTING 1 [get_pblocks pblock_1]\n");
+            md.append("report_utilization -pblocks pblock_1 -packthru -file " + prefix + ".util\n");
+            md.append("write_checkpoint -force " + prefix + "_placedRouted.dcp\n");
+            md.append("write_edif -force " + prefix + "_placedRouted.edf\n");
+            md.append("generate_metadata " + prefix + "_placedRouted.dcp " + libDir + "/ 0\n");
+            md.append("close_design\n");
+            md.append("puts \"META_OK " + it.pblock.pblockName + "\"\n");
+            md.append("}\n");
+        }
+        Path mdTcl = dir.toPath().resolve("metadata.tcl");
+        Path mdLog = dir.toPath().resolve("metadata.log");
+        Files.write(mdTcl, md.toString().getBytes(StandardCharsets.UTF_8));
+        VivadoRun.vivadoRun(mdTcl.toString(), mdLog.toString(), false, "batch metadata: " + dir, 0);
+        String mdOut = new String(Files.readAllBytes(mdLog), StandardCharsets.ISO_8859_1);
+        for (Item it : split)
+        {
+            Path libDir = LocationParser.getPlacedRoutedDCPsPath().resolve(it.comp.dcpName);
+            boolean files = libDir.resolve(it.pblock.pblockName + "_placedRouted_0_metadata.txt").toFile().exists()
+                && libDir.resolve(it.pblock.pblockName + ".util").toFile().exists();
+            it.ok = files && mdOut.contains("META_OK " + it.pblock.pblockName + "\n");
+            if (!it.ok)
+                GenerateFastPblocks.removeOutputs(libDir, it.pblock.pblockName);
+        }
+    }
+}
diff --git a/src/ch/agsl/dynarapid/pblockgenerator/GenerateFastPblocks.java b/src/ch/agsl/dynarapid/pblockgenerator/GenerateFastPblocks.java
