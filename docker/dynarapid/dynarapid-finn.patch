+    /*
+     * BRAM / DSP cascades (dedicated connections between vertically adjacent sites) must not
+     * cross a clock region boundary (DRC CASC-31). Relocation checks do not know this: an anchor
+     * is dropped if it would put cascaded sites of the module into different clock regions.
+     */
+    static HashSet<Site> removeCascadeSplits(Module m, HashSet<Site> valid) {
+        java.util.List<java.util.List<com.xilinx.rapidwright.design.SiteInst>> groups = new java.util.ArrayList<>();
+        for (com.xilinx.rapidwright.design.Net n : m.getNets()) {
+            //a cascade connection: net driven by a cascade output, to the next site(s)
+            com.xilinx.rapidwright.design.SitePinInst src = n.getSource();
+            if (src == null || !isCascadeOutPin(src.getName()))
+                continue;
+            java.util.Set<com.xilinx.rapidwright.design.SiteInst> g = new java.util.HashSet<>();
+            for (com.xilinx.rapidwright.design.SitePinInst p : n.getPins())
+                g.add(p.getSiteInst());
+            if (g.size() > 1)
+                groups.add(new java.util.ArrayList<>(g));
+        }
+        if (groups.isEmpty())
+            return valid;
+        HashSet<Site> res = new HashSet<>();
+        for (Site anchor : valid) {
+            boolean ok = true;
+            for (java.util.List<com.xilinx.rapidwright.design.SiteInst> g : groups) {
+                com.xilinx.rapidwright.device.ClockRegion cr = null;
+                for (com.xilinx.rapidwright.design.SiteInst si : g) {
