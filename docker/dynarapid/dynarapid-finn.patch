index 0000000..9f241e7
--- /dev/null
+++ b/src/ch/agsl/dynarapid/pblockgenerator/GenerateShapedPblocks.java
@@ -0,0 +1,161 @@
+/*
+* DynaRapid
+*
+* This file is part of DynaRapid project
+* Copyright: See COPYING file that comes with this distribution
+*/
+
+package ch.agsl.dynarapid.pblockgenerator;
+
+import ch.agsl.dynarapid.GenerateDesign;
+import ch.agsl.dynarapid.entry.Start;
+import ch.agsl.dynarapid.error.ErrorLogger;
+import ch.agsl.dynarapid.map.ResourceElement;
+import ch.agsl.dynarapid.modules.Component;
+import ch.agsl.dynarapid.modules.Pblock;
+import ch.agsl.dynarapid.parser.LocationParser;
+import ch.agsl.dynarapid.strings.StringUtils;
+
+import java.io.File;
+
+/**
+ * Pblock generator for large components (e.g. FINN layers).
+ *
+ * The legacy PblockGenerator grows a pblock from the right edge of the generation region one
+ * row at a time, starting with a single column. For components with hundreds or thousands of
+ * CLBs this yields very tall, one-column shapes and one Vivado run per failed attempt.
+ *
+ * This generator picks a compact (roughly square) shape directly from the component's resource
+ * needs at a target utilization, and relaxes the utilization (growing the pblock in both
+ * dimensions) only when Vivado fails to place or route it. Several shapes with different
+ * aspect ratios can be requested to give the placer more freedom.
+ */
+public class GenerateShapedPblocks {
+
+    //Physical width of one map column in CLB tiles (a map column holds a left and a right element)
+    static final double COL_WIDTH = 2.0;
+
+    static int[] chooseShape(Component comp, double util, double aspect, int maxRows)
+    {
+        ResourceElement need = comp.dcp;
+        //CLB resources get the utilization headroom. DSP / BRAM sites are used exactly on the
+        //first attempt (util >= 0.8); retries at lower utilization also add headroom for them,
+        //e.g. for BRAM cascades that need enough consecutive sites in one column
+        double hard = Math.min(1.0, util / 0.8);
+        ResourceElement scaled = new ResourceElement(
+            (int)Math.ceil(need.clel / util), (int)Math.ceil(need.clem / util),
+            (int)Math.ceil(need.dsp / hard), (int)Math.ceil(need.bram / hard));
+
+        int inc = comp.incFactor;
+        int si = ResourceElement.starti;
+        int best[] = null;
+        double bestScore = Double.MAX_VALUE;
+
+        for (int j = ResourceElement.startj; j <= ResourceElement.endj; j++)
+            for (int c = 1; j + c - 1 <= ResourceElement.endj; c++)
+            {
+                //smallest number of rows (multiple of the increment factor) that fits
+                for (int r = inc; r <= maxRows; r += inc)
+                {
+                    ResourceElement re = ResourceElement.getPblock(si, j, si + r - 1, j + c - 1);
+                    if (!re.isPblockAppropriate(scaled))
+                        continue;
+
+                    //area plus a penalty for deviating from the requested aspect ratio (height / width)
+                    double ratio = r / (c * COL_WIDTH);
+                    double dev = Math.max(ratio / aspect, aspect / ratio);
+                    double score = r * c * COL_WIDTH * dev;
+                    if (score < bestScore)
+                    {
+                        bestScore = score;
+                        best = new int[] {j, r, c};
+                    }
+                    break;
+                }
+            }
+        return best;
+    }
+
+    public static void main(String args[])
+    {
+        if (StringUtils.findInArray("-m", args) == -1)
+        {
+            System.out.println("<usage>: java GenerateShapedPblocks -m <component> [-part <part>] [-util <u>] [-num <n>] [-tries <t>]");
+            System.out.println("-util <arg> - Initial target utilization of the pblock resources (default 0.6)");
+            System.out.println("-num <arg>  - Number of shapes (different aspect ratios) to generate (default 1)");
+            System.out.println("-tries <arg> - Attempts per shape, relaxing the utilization by 25% each time (default 5)");
+            return;
+        }
+
+        if (StringUtils.findInArray("-part", args) != -1)
+            GenerateDesign.setPart(args[StringUtils.findInArray("-part", args) + 1]);
+
+        if (!Start.start())
+            return;
+
+        String dcpName = args[StringUtils.findInArray("-m", args) + 1];
+        double util0 = 0.6;
+        int num = 1;
+        int tries = 5;
+        if (StringUtils.findInArray("-util", args) != -1)
+            util0 = Double.parseDouble(args[StringUtils.findInArray("-util", args) + 1]);
+        if (StringUtils.findInArray("-num", args) != -1)
+            num = Integer.parseInt(args[StringUtils.findInArray("-num", args) + 1]);
+        if (StringUtils.findInArray("-tries", args) != -1)
+            tries = Integer.parseInt(args[StringUtils.findInArray("-tries", args) + 1]);
+
+        File vhdlDCP = new File(LocationParser.vhdlSynthDCPs + dcpName + "_synth.dcp");
+        File genericDCP = new File(LocationParser.genericSynthDCPs + dcpName + "_synth.dcp");
+        if (!vhdlDCP.exists() && !genericDCP.exists())
+        {
+            System.out.println("ERROR: Could not find synthesized DCP for the module: " + dcpName);
+            System.exit(1);
+        }
+
+        Component comp = new Component(dcpName, false);
+        int maxRows = ResourceElement.endi - ResourceElement.starti + 1;
+
+        //aspect ratios (height / width in CLB tiles) tried for the successive shapes
+        double aspects[] = {1.0, 2.0, 0.5, 4.0};
+        int generated = 0;
+
+        for (int s = 0; s < num && s < aspects.length; s++)
+        {
+            double util = util0;
+            for (int t = 0; t < tries; t++)
+            {
+                int shape[] = chooseShape(comp, util, aspects[s], maxRows);
+                if (shape == null)
+                {
+                    System.out.println("No pblock in the generation region fits the component at utilization " + util);
+                    break;
+                }
+                StringUtils.printIntro("Shape " + s + " try " + t + ": rows " + shape[1] + " cols " + shape[2] + " at J " + shape[0] + " (target utilization " + util + ")");
+
+                if (!comp.searchPblockList(ResourceElement.getPblock(ResourceElement.starti, shape[0],
+                        ResourceElement.starti + shape[1] - 1, shape[0] + shape[2] - 1)).equals(""))
+                {
+                    System.out.println("Shape already generated");
+                    break;
+                }
+
+                Pblock pblock = new Pblock(comp, ResourceElement.starti, shape[0], shape[1], shape[2], 1, true, false);
+                System.out.println("Pblock status: " + pblock.currStatus);
+                if (pblock.currStatus == 7)
+                {
+                    comp.pblockList.add(pblock);
+                    generated++;
+                    break;
+                }
+                if (pblock.currStatus != 2 && pblock.currStatus != 3 && pblock.currStatus != 4)
+                    break; //not a placement / routing capacity problem, relaxing will not help
+
+                util *= 0.75;
+            }
+        }
+
+        System.out.println("Generated " + generated + " pblock(s) for " + dcpName);
+        ErrorLogger.printErrorLogs();
+        System.exit(generated > 0 ? 0 : 1);
+    }
+}
