+            ArrayList<Integer> cols = new ArrayList<>();
+            for(int j = 0; j < numCols; j++)
+                if(isHole(i, j))
+                    cols.add(j);
+            if(cols.size() == numCols)
+                continue; //empty row, removed anyway
+            usedRows++;
+            if(!cols.isEmpty())
+            {
+                holeRows.add(i);
+                holeCols.addAll(cols);
+            }
+        }
+        if(holeCols.isEmpty() || (long) holeCols.size() * usedRows >= (long) holeRows.size() * numCols)
+            return;
+
+        ArrayList<ArrayList<MapElement>> tempMap = new ArrayList<>();
+        for(int i = 0; i < numRows; i++)
+        {
+            ArrayList<MapElement> row = new ArrayList<>();
+            for(int j = 0; j < numCols; j++)
+                if(!holeCols.contains(j))
+                    row.add(MapElement.map.get(i).get(j));
+            tempMap.add(row);
+        }
+        ArrayList<Integer> kept = new ArrayList<>();
+        for(int j = 0; j < MapElement.colAdded.size(); j++)
+            if(!holeCols.contains(j))
+                kept.add(MapElement.colAdded.get(j));
+        MapElement.colAdded = kept;
+        MapElement.map = tempMap;
