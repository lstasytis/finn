+    //dedicated cascade outputs of RAMB and DSP sites
+    static boolean isCascadeOutPin(String pin) {
+        return pin.startsWith("CASDO") || pin.startsWith("CASO") || pin.startsWith("ACOUT")
+            || pin.startsWith("BCOUT") || pin.startsWith("PCOUT") || pin.startsWith("CARRYCASCOUT")
