     public static boolean routeDesignPartially(Design design, Path finalLocation)
     {
         StringUtils.printIntro("Started partial routing using RWRouter");
-        design.flattenDesign();
-        EDIFTools.uniqueifyNetlist(design);
-        boolean softPreserve = true;
-        design = PartialRouter.routeDesignPartialNonTimingDriven(design, null, softPreserve);
+        //DYNARAPID_ROUTE_MODE=noflatten keeps the module hierarchy: flattening can separate the
+        //pre-routed physical nets of the modules from their logical nets
+        String mode = System.getenv("DYNARAPID_ROUTE_MODE");
+        if(mode != null && mode.contains("noflatten"))
+        {
+            design.getNetlist().resetParentNetMap();
+            DesignTools.makePhysNetNamesConsistent(design);
+            DesignTools.createMissingSitePinInsts(design);
+        }
+        else
+        {
+            design.flattenDesign();
+            EDIFTools.uniqueifyNetlist(design);
+        }
+        boolean softPreserve = !(mode != null && mode.contains("hardpreserve"));
+        //DYNARAPID_ROUTE_MODE containing "timing": timing-driven routing of the remaining nets
+        if(mode != null && mode.contains("timing"))
+            design = PartialRouter.routeDesignPartialTimingDriven(design, null, softPreserve);
+        else
+        {
+            //DYNARAPID_RWROUTE_MAX_ITER: iteration limit of RWRoute (default 100). A few overlaps
+            //can persist for dozens of iterations; when the design is routed again afterwards
+            //(e.g. assembled into a shell by Vivado) a lower limit saves that time
+            java.util.List<String> a = new java.util.ArrayList<>(java.util.Arrays.asList(
+                "--fixBoundingBox", "--useUTurnNodes", "--nonTimingDriven", "--verbose"));
+            String it = System.getenv("DYNARAPID_RWROUTE_MAX_ITER");
+            if(it != null && !it.isEmpty())
+            {
+                a.add("--maxIterations");
+                a.add(it);
+            }
+            design = PartialRouter.routeDesignWithUserDefinedArguments(design, a.toArray(new String[0]), null, softPreserve);
+        }
+        removeEmptyBusNets(design);
         design.writeCheckpoint(finalLocation);
         return true;
     }
 
+    /*
+     * Vivado's OOC netlists of the components contain unconnected placeholder nets named
+     * "[msb:lsb]<bus>" (with __HD_ORIG_NAME). When the stitched design is read back, Vivado
+     * folds them into the bus nets of the same name and warns (EDIF 20-100). They carry no
+     * connectivity, so they are dropped.
+     */
+    public static void removeEmptyBusNets(Design design)
+    {
+        int removed = 0;
+        for (com.xilinx.rapidwright.edif.EDIFLibrary lib : design.getNetlist().getLibraries())
+            for (com.xilinx.rapidwright.edif.EDIFCell cell : lib.getCells())
+            {
+                java.util.List<String> empty = new java.util.ArrayList<>();
+                for (com.xilinx.rapidwright.edif.EDIFNet net : cell.getNets())
+                    if (net.getName().startsWith("[") && net.getPortInsts().isEmpty())
+                        empty.add(net.getName());
+                for (String n : empty)
+                    cell.removeNet(n);
+                removed += empty.size();
+            }
+        System.out.println("Removed " + removed + " empty bus placeholder nets");
+    }
