+    //smallest area (in map cells) among the shapes of the node's component
+    static int minShapeArea(Node node)
+    {
+        int best = Integer.MAX_VALUE;
+        for(Shape sh : node.component.shapeList)
+            best = Math.min(best, sh.currRow * sh.currCol);
