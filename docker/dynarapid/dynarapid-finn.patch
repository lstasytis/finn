+*/
+
+package ch.agsl.dynarapid.pblockgenerator;
+
+import ch.agsl.dynarapid.GenerateDesign;
+import ch.agsl.dynarapid.entry.Start;
+import ch.agsl.dynarapid.map.MapElement;
+import ch.agsl.dynarapid.map.ResourceElement;
+import ch.agsl.dynarapid.modules.Component;
+import ch.agsl.dynarapid.modules.Pblock;
+import ch.agsl.dynarapid.parser.LocationParser;
+import ch.agsl.dynarapid.strings.StringUtils;
+import ch.agsl.dynarapid.vivado.VivadoRun;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * Single-run pblock generator.
+ *
+ * The regular flow implements a component three times (placement and routing inside the pblock,
+ * again with flip-flops around the pblock that pull the port nets to its boundary, and a repair
+ * run after removing the flip-flops), each time reopening the checkpoint in a new Vivado session.
+ *
+ * This generator implements the synthesized component once inside a compact pblock (see
+ * GenerateShapedPblocks) and then unroutes only the nets of the component's ports; RWRoute routes
+ * them when the components are stitched. The result has the same layout as the regular library
+ * (placed and routed DCP + EDIF + RapidWright metadata + pblock utilization), so the normal
+ * database generation and GenerateDesign use it unchanged.
+ */
+public class GenerateFastPblocks {
+
+    static String tcl(Component comp, Pblock pblock, Path libDir)
+    {
+        String name = pblock.pblockName;
+        String prefix = libDir.resolve(name).toString();
+        StringBuilder t = new StringBuilder();
+        t.append("set_param general.maxThreads " + VivadoRun.vivadoThreads() + "\n");
+        t.append("open_checkpoint " + comp.moduleLoc + "\n");
+        t.append("create_clock -period " + VivadoRun.clockPeriod() + " -name clk [get_ports clk]\n");
+        t.append("set_property HD.CLK_SRC " + ch.agsl.dynarapid.vivado.VivadoRun.clockSourceSite() + " [get_ports clk]\n");
+        t.append("create_pblock pblock_1\n");
+        t.append(StringUtils.getPblockString(pblock.getAllSites(), "pblock_1"));
+        t.append("add_cells_to_pblock pblock_1 -top\n");
+        t.append("set_property CONTAIN_ROUTING 1 [get_pblocks pblock_1]\n");
+        t.append("opt_design\n");
+        t.append("place_design\n");
+        t.append("route_design\n");
+        t.append("report_route_status\n");
+        //the port nets are routed at stitching time, from/to the neighbouring components.
+        //The clock is unrouted too: its (out-of-context) clock-tree PIPs would restrict relocation
+        //to the same position within a clock region (e.g. 156 instead of ~57000 anchors on a U250)
+        t.append("set port_nets [get_nets -quiet -of [get_ports]]\n");
+        t.append("if {[llength $port_nets] > 0} { route_design -unroute -nets $port_nets }\n");
+        t.append("report_utilization -pblocks pblock_1 -packthru -file " + prefix + ".util\n");
+        t.append("write_checkpoint -force " + prefix + "_placedRouted.dcp\n");
+        t.append("write_edif -force " + prefix + "_placedRouted.edf\n");
+        t.append(LocationParser.sourceRW + "\n");
+        t.append("generate_metadata " + prefix + "_placedRouted.dcp " + libDir + "/ 0\n");
+        return t.toString();
+    }
+
+    //0: success, 2: placement failed, 4: routing errors, -1: other error
+    static int check(Path log) throws Exception
+    {
+        String s = new String(Files.readAllBytes(log), StandardCharsets.ISO_8859_1);
+        if (!s.contains("place_design completed successfully"))
+            return 2;
+        if (!s.contains("route_design completed successfully") || !s.contains("# of nets with routing errors.......... :           0 :"))
+            return 4;
+        if (!s.contains("Entering generate_metadata") || s.contains("\nERROR:"))
+            return -1;
+        return 0;
+    }
+
+    static void removeOutputs(Path libDir, String name)
+    {
+        for (String suffix : new String[] {"_placedRouted.dcp", "_placedRouted.edf", "_placedRouted_load.tcl", "_placedRouted_0_metadata.txt", ".util", ".report"})
+            libDir.resolve(name + suffix).toFile().delete();
+    }
+
+    //Hedged search for one pblock (shapes avoiding the excluded map columns); returns the
+    //name of the kept pblock or null
+    static String hedged(Component comp, Path libDir, File workDir, double util, int tries,
+            int parallel, int maxRows, boolean[] excluded) throws Exception
+    {
+        //Hedged attempts at decreasing target utilization: `parallel` attempts start at once;
+        //whenever the least dense running attempt has not finished after the hedge delay
+        //(DYNARAPID_HEDGE_S, default 150 s: a congested pblock can keep the router busy for
+        //many minutes before it fails) or an attempt failed, the next, less dense one starts.
+        //The densest successful pblock is kept: once an attempt succeeds, less dense ones are
+        //cancelled and denser ones still running get a grace period.
+        long hedgeMs = 150000;
+        if (System.getenv("DYNARAPID_HEDGE_S") != null)
+            hedgeMs = (long) (Double.parseDouble(System.getenv("DYNARAPID_HEDGE_S")) * 1000);
+        int maxRunning = Math.max(parallel, 2);
+        java.util.List<Pblock> att = new java.util.ArrayList<>();
+        java.util.List<Double> utils = new java.util.ArrayList<>();
+        java.util.List<Thread> threads = new java.util.ArrayList<>();
+        java.util.List<Long> started = new java.util.ArrayList<>();
+        java.util.Set<String> names = new java.util.HashSet<>();
+        final int status[] = new int[tries];
+        double u = util;
+        boolean exhausted = false;
+        long deadline = Long.MAX_VALUE;
+        int best = -1;
+        while (true)
+        {
+            int running = 0, lastRunning = -1, success = -1;
+            boolean retryable = false;
+            for (int k = 0; k < threads.size(); k++)
+            {
+                if (threads.get(k).isAlive())
+                {
+                    running++;
+                    lastRunning = k;
+                }
+                else if (status[k] == 0 && success == -1)
+                    success = k;
+                else if (status[k] == 2 || status[k] == 4)
+                    retryable = true;
+            }
+            if (success != -1)
+            {
+                //less dense attempts are not needed any more
+                for (int k = success + 1; k < threads.size(); k++)
+                    if (threads.get(k).isAlive())
+                        cancel(att.get(k), workDir, status, k);
+                boolean denserRunning = false;
+                for (int k = 0; k < success; k++)
+                    denserRunning |= threads.get(k).isAlive();
+                if (deadline == Long.MAX_VALUE)
+                    deadline = System.currentTimeMillis() + Math.max(60000, (System.currentTimeMillis() - started.get(success)) / 2);
+                if (!denserRunning || System.currentTimeMillis() > deadline)
+                {
+                    for (int k = 0; k < success; k++)
+                        if (threads.get(k).isAlive())
+                            cancel(att.get(k), workDir, status, k);
+                    for (Thread th : threads)
+                        th.join();
+                    for (int k = 0; k < threads.size(); k++)
+                        if (status[k] == 0 && best == -1)
+                            best = k;
+                    break;
+                }
+            }
+            else
+            {
+                boolean launch = threads.size() < parallel
+                    || (running == 0 && (threads.isEmpty() || retryable))
+                    || (running > 0 && running < maxRunning
+                        && System.currentTimeMillis() - started.get(lastRunning) > hedgeMs);
+                if (launch && !exhausted && threads.size() < tries)
+                {
+                    Pblock pblock = null;
+                    while (pblock == null && !exhausted)
+                    {
+                        int shape[] = GenerateShapedPblocks.chooseShape(comp, u, 1.0, maxRows, excluded);
+                        if (shape == null)
+                        {
+                            System.out.println("No pblock in the generation region fits the component at utilization " + u);
+                            exhausted = true;
+                            break;
+                        }
+                        //stage 2 only builds the pblock object (sites, name); nothing is run
+                        Pblock p = new Pblock(comp, ResourceElement.starti, shape[0], shape[1], shape[2], 2, false, false);
+                        if (names.add(p.pblockName))
+                            pblock = p;
+                        else
+                            u *= 0.75;
+                    }
+                    if (pblock != null)
+                    {
+                        final int kk = threads.size();
+                        final Pblock pb = pblock;
+                        final double uu = u;
+                        att.add(pb);
+                        utils.add(uu);
+                        Thread th = new Thread(() -> status[kk] = attempt(comp, pb, libDir, workDir, uu));
+                        started.add(System.currentTimeMillis());
+                        threads.add(th);
+                        th.start();
+                        u *= 0.75;
+                        continue;
+                    }
+                }
+                if (running == 0 && (exhausted || threads.size() >= tries || !retryable))
+                    break;
+            }
+            Thread.sleep(2000);
+        }
+        for (int k = 0; k < att.size(); k++)
+            if (k != best)
+                removeOutputs(libDir, att.get(k).pblockName);
+        if (best != -1)
+        {
+            System.out.println("Kept " + att.get(best).pblockName);
+            return att.get(best).pblockName;
+        }
+        return null;
+    }
+
+    static void cancel(Pblock pblock, File workDir, int[] status, int k)
+    {
+        System.out.println("Cancelling " + pblock.pblockName);
+        status[k] = -2;
+        VivadoRun.kill(workDir.toPath().resolve(pblock.pblockName + "_fast.tcl").toString());
+    }
+
+    //Implements the component in the given pblock; returns the status of check()
+    static int attempt(Component comp, Pblock pblock, Path libDir, File workDir, double util)
+    {
+        try
+        {
+            StringUtils.printIntro("Attempt: " + pblock.pblockName + " (target utilization " + util + ")");
+            Path tclLoc = workDir.toPath().resolve(pblock.pblockName + "_fast.tcl");
+            Path logLoc = workDir.toPath().resolve(pblock.pblockName + "_fast.report");
+            try (FileWriter w = new FileWriter(tclLoc.toFile()))
+            {
+                w.write(tcl(comp, pblock, libDir));
+            }
+            VivadoRun.vivadoRun(tclLoc.toString(), logLoc.toString(), false, "fast pblock: " + pblock.pblockName, 0);
+            int status = check(logLoc);
+            System.out.println("Pblock status: " + status + " for " + pblock.pblockName);
+            if (status == 0)
+                Files.copy(logLoc, libDir.resolve(pblock.pblockName + ".report"), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+            return status;
+        }
+        catch (Exception e)
+        {
+            e.printStackTrace();
+            return -1;
+        }
+    }
+
+    public static void main(String args[]) throws Exception
+    {
+        if (StringUtils.findInArray("-m", args) == -1)
+        {
+            System.out.println("<usage>: java GenerateFastPblocks -m <component> [-part <part>] [-util <u>] [-tries <t>] [-parallel <n>]");
+            return;
+        }
+        if (StringUtils.findInArray("-part", args) != -1)
+            GenerateDesign.setPart(args[StringUtils.findInArray("-part", args) + 1]);
+        if (!Start.start())
+            return;
+
+        String dcpName = args[StringUtils.findInArray("-m", args) + 1];
+        double util = 0.6;
+        int tries = 5;
+        if (StringUtils.findInArray("-util", args) != -1)
+            util = Double.parseDouble(args[StringUtils.findInArray("-util", args) + 1]);
+        if (StringUtils.findInArray("-tries", args) != -1)
+            tries = Integer.parseInt(args[StringUtils.findInArray("-tries", args) + 1]);
+
+        if (!new File(LocationParser.vhdlSynthDCPs + dcpName + "_synth.dcp").exists()
+                && !new File(LocationParser.genericSynthDCPs + dcpName + "_synth.dcp").exists())
+        {
+            System.out.println("ERROR: Could not find synthesized DCP for the module: " + dcpName);
+            System.exit(1);
+        }
+
+        Component comp = new Component(dcpName, false);
+        Path libDir = LocationParser.getPlacedRoutedDCPsPath().resolve(dcpName);
+        libDir.toFile().mkdirs();
+        File workDir = new File(LocationParser.exposedDCPs + dcpName);
+        workDir.mkdirs();
+        int maxRows = ResourceElement.endi - ResourceElement.starti + 1;
+
+        int parallel = 1;
+        if (StringUtils.findInArray("-parallel", args) != -1)
+            parallel = Integer.parseInt(args[StringUtils.findInArray("-parallel", args) + 1]);
+
+        //Components with BRAMs / DSPs can usually only be relocated vertically (the column
+        //pattern of the fabric rarely repeats): several variants at disjoint columns
+        //(DYNARAPID_VARIANTS, default 2) give the placer the choice between column bands.
+        int variants = 1;
+        if (comp.dcp.bram > 0 || comp.dcp.dsp > 0)
+            variants = System.getenv("DYNARAPID_VARIANTS") == null ? 2 : Integer.parseInt(System.getenv("DYNARAPID_VARIANTS"));
+        int cols = MapElement.map.get(0).size();
+        java.util.List<boolean[]> masks = new java.util.ArrayList<>();
+        boolean[] used = new boolean[cols];
+        for (int v = 0; v < variants; v++)
+        {
+            int shape[] = GenerateShapedPblocks.chooseShape(comp, util, 1.0, maxRows, v == 0 ? null : used);
+            if (shape == null)
+                break;
+            masks.add(v == 0 ? null : used.clone());
+            for (int j = shape[0]; j < shape[0] + shape[2] && j < cols; j++)
+                used[j] = true;
+        }
+        final double util0 = util;
+        final int tries0 = tries, parallel0 = parallel;
+        String kept[] = new String[masks.size()];
+        java.util.List<Thread> vthreads = new java.util.ArrayList<>();
+        for (int v = 0; v < masks.size(); v++)
+        {
+            final int vv = v;
+            Thread th = new Thread(() -> {
+                try { kept[vv] = hedged(comp, libDir, workDir, util0, tries0, parallel0, maxRows, masks.get(vv)); }
+                catch (Exception e) { e.printStackTrace(); }
+            });
+            th.start();
+            vthreads.add(th);
+        }
+        for (Thread th : vthreads)
+            th.join();
+        int n = 0;
+        for (String k : kept)
+            if (k != null)
+                n++;
+        if (n > 0)
+        {
+            System.out.println("Generated " + n + " pblock(s) for " + dcpName);
+            System.exit(0);
+        }
+        System.out.println("Generated 0 pblock(s) for " + dcpName);
+        System.exit(1);
+    }
+}
